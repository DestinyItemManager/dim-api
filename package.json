{
  "name": "dim-api",
  "version": "1.0.0",
  "description": "Destiny Item Manager API Server",
  "main": "api/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DestinyItemManager/dim-api.git"
  },
  "private": true,
  "author": "Ben Hollis <ben@benhollis.net>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "rm -rf dist && pnpm build:api && node -r dotenv/config dist/api/index.js",
    "build:api": "tsc -p ./api/tsconfig.json",
    "deploy": "kubernetes/deploy.sh",
    "docker:build": "rm -rf dist && pnpm build:api && docker build -t destinyitemmanager/dim-api .",
    "docker:run": "docker run -p 3000:3000 destinyitemmanager/dim-api:latest",
    "docker:push": "docker push destinyitemmanager/dim-api:latest",
    "lint": "eslint --fix api",
    "lint-check": "eslint api",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --verbose --coverage --forceExit",
    "test:watch": "jest --watch",
    "eslint-inspect": "pnpm dlx @eslint/config-inspector",
    "dim-api-types:build": "./build-dim-api-types.sh"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@sentry/cli": "^2.58.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@types/vhost": "3.0.7",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.7.1",
    "eslint": "^10.15.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-sonarjs": "^1.0.4",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rollup": "^4.68.8",
    "supertest-fetch": "^2.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@godaddy/terminus": "^4.12.1",
    "@octokit/oauth-app": "^7.1.6",
    "@octokit/rest": "^21.1.1",
    "@sentry/node": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "bungie-api-ts": "^5.10.0",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "es-toolkit": "^1.53.2",
    "express": "^4.22.3",
    "express-async-handler": "^1.2.0",
